generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  name              String
  nickname          String
  email             String              @unique
  emailVerified     DateTime            @default(now())
  image             String?
  googleId          String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  password          String?
  cycleSettings     UserCycleSettings?
  cyclePeriodOverrides CyclePeriodOverride[]
  creditCardStatementClosings CreditCardStatementClosing[]
  categories        Category[]
  debts             Debt[]
  installmentPlans  InstallmentPlan[]
  installmentItems  InstallmentOccurrence[]
  people            Person[]
  scheduledOccurs   ScheduledOccurrence[]
  scheduledPlans    ScheduledPlan[]
  tags              Tag[]
  transactions      Transaction[]
  wallets           Wallet[]
}

model UserCycleSettings {
  id             String          @id @default(cuid())
  userId         String          @unique
  defaultStartDay Int
  timezone       String          @default("America/Bogota")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides      CycleOverride[]
}

model CycleOverride {
  id              String            @id @default(cuid())
  cycleSettingsId String
  effectiveFrom   DateTime
  startDay        Int
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  cycleSettings   UserCycleSettings @relation(fields: [cycleSettingsId], references: [id], onDelete: Cascade)

  @@index([cycleSettingsId, effectiveFrom])
}

model CyclePeriodOverride {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

model Wallet {
  id                  String              @id @default(cuid())
  userId              String
  parentWalletId      String?
  name                String
  balance             BigInt
  type                WalletType
  color               String
  includeInTotal      Boolean
  isSavingsBox        Boolean             @default(false)
  fareValue           BigInt?
  isActive            Boolean             @default(true)
  creditLimit         BigInt?
  availableCredit     BigInt?
  statementClosingDay Int?
  paymentDueDay       Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  scheduledAsSource   ScheduledPlan[]     @relation("ScheduledSourceWallet")
  scheduledAsTarget   ScheduledPlan[]     @relation("ScheduledTargetWallet")
  statementClosings    CreditCardStatementClosing[]
  installmentCharges  InstallmentPlan[]   @relation("InstallmentChargeWallet")
  installmentPayments InstallmentPlan[]   @relation("InstallmentPaymentWallet")
  transactions        Transaction[]       @relation("TransactionWallet")
  transferFrom        Transaction[]       @relation("TransferFromWallet")
  transferTo          Transaction[]       @relation("TransferToWallet")
  parentWallet        Wallet?             @relation("WalletSavingsBoxes", fields: [parentWalletId], references: [id], onDelete: SetNull)
  savingsBoxes        Wallet[]            @relation("WalletSavingsBoxes")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, parentWalletId])
}

model CreditCardStatementClosing {
  id             String   @id @default(cuid())
  userId         String
  walletId       String
  statementMonth DateTime
  closingAt      DateTime
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, statementMonth])
  @@index([userId, walletId, statementMonth])
}

model Category {
  id                String            @id @default(cuid())
  userId            String?
  parentId          String?
  name              String
  color             String
  slug              String?
  isSystem          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryHierarchy")
  installmentPlans  InstallmentPlan[]
  scheduledPlans    ScheduledPlan[]
  transactions      Transaction[]
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, parentId])
}

model Tag {
  id          String           @id @default(cuid())
  userId      String
  name        String
  color       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  transactions TransactionTag[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model TransactionTag {
  transactionId String
  tagId         String
  createdAt     DateTime     @default(now())
  tag           Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Person {
  id          String        @id @default(cuid())
  userId      String
  name        String
  alias       String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  debts       Debt[]
  transactions Transaction[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Debt {
  id              String          @id @default(cuid())
  userId          String
  personId        String
  title           String
  direction       DebtDirection
  principalAmount BigInt
  currentBalance  BigInt
  status          DebtStatus      @default(ACTIVA)
  startedAt       DateTime
  settledAt       DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  person          Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledPlan {
  id                    String                @id @default(cuid())
  userId                String
  title                 String
  description           String
  kind                  ScheduledPlanKind
  amountMode            AmountMode
  fixedAmount           BigInt?
  frequency             RecurrenceFrequency
  interval              Int                   @default(1)
  dueDay                Int?
  startsAt              DateTime
  endsAt                DateTime?
  targetWalletId        String?
  sourceWalletId        String?
  categoryId            String?
  affectsProjectedBudget Boolean              @default(true)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  category              Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences           ScheduledOccurrence[]
  sourceWallet          Wallet?               @relation("ScheduledSourceWallet", fields: [sourceWalletId], references: [id], onDelete: SetNull)
  targetWallet          Wallet?               @relation("ScheduledTargetWallet", fields: [targetWalletId], references: [id], onDelete: SetNull)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
}

model ScheduledOccurrence {
  id                String             @id @default(cuid())
  planId            String
  userId            String
  dueAt             DateTime
  expectedAmount    BigInt
  status            OccurrenceStatus   @default(PENDIENTE)
  linkedTransactionId String?          @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  linkedTransaction Transaction?       @relation("ScheduledOccurrenceTransaction", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  plan              ScheduledPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstallmentPlan {
  id                   String                  @id @default(cuid())
  userId               String
  title                String
  description          String?
  merchant             String?
  categoryId           String?
  chargeWalletId       String?
  paymentWalletId      String?
  totalAmount          BigInt
  installmentAmount    BigInt
  totalInstallments    Int
  remainingInstallments Int
  interestRate         Decimal?                @db.Decimal(8, 4)
  occurredAt           DateTime
  firstDueAt           DateTime
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  category             Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  chargeWallet         Wallet?                 @relation("InstallmentChargeWallet", fields: [chargeWalletId], references: [id], onDelete: SetNull)
  occurrences          InstallmentOccurrence[]
  paymentWallet        Wallet?                 @relation("InstallmentPaymentWallet", fields: [paymentWalletId], references: [id], onDelete: SetNull)
  transactions         Transaction[]
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstallmentOccurrence {
  id                String             @id @default(cuid())
  installmentPlanId String
  userId            String
  installmentNumber Int
  dueAt             DateTime
  expectedAmount    BigInt
  status            OccurrenceStatus   @default(PENDIENTE)
  linkedTransactionId String?          @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  installmentPlan   InstallmentPlan    @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  linkedTransaction Transaction?       @relation("InstallmentOccurrenceTransaction", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([installmentPlanId, installmentNumber])
}

model Transaction {
  id                     String                 @id @default(cuid())
  userId                 String
  walletId               String
  type                   TransactionType
  status                 TransactionStatus     @default(REGISTRADA)
  title                  String
  description            String
  categoryId             String?
  amount                 BigInt
  fareValue              BigInt?
  numberOfTrips          Int?
  fromWalletId           String?
  toWalletId             String?
  occurredAt             DateTime
  recordedAt             DateTime
  isVisible              Boolean                @default(true)
  scheduledPlanId        String?
  scheduledOccurrenceId  String?                @unique
  installmentPlanId      String?
  installmentOccurrenceId String?               @unique
  debtId                 String?
  personId               String?
  refundedTransactionId  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  category               Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debt                   Debt?                  @relation(fields: [debtId], references: [id], onDelete: SetNull)
  installmentOccurrence  InstallmentOccurrence? @relation("InstallmentOccurrenceTransaction")
  installmentPlan        InstallmentPlan?       @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  person                 Person?                @relation(fields: [personId], references: [id], onDelete: SetNull)
  refundedTransaction    Transaction?           @relation("TransactionRefund", fields: [refundedTransactionId], references: [id], onDelete: SetNull)
  refundTransactions     Transaction[]          @relation("TransactionRefund")
  scheduledOccurrence    ScheduledOccurrence?   @relation("ScheduledOccurrenceTransaction")
  scheduledPlan          ScheduledPlan?         @relation(fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  tags                   TransactionTag[]
  transferFromWallet     Wallet?                @relation("TransferFromWallet", fields: [fromWalletId], references: [id], onDelete: SetNull)
  transferToWallet       Wallet?                @relation("TransferToWallet", fields: [toWalletId], references: [id], onDelete: SetNull)
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                 Wallet                 @relation("TransactionWallet", fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([refundedTransactionId])
}

enum WalletType {
  EFECTIVO
  CUENTA_BANCARIA
  AHORROS
  TRANSPORTE
  TARJETA_CREDITO
}

enum TransactionType {
  INGRESO
  GASTO
  TRANSPORTE
  TRANSFERENCIA
  TARJETA_CONSUMO
  TARJETA_DEVOLUCION
  PAGO_TARJETA
  DEUDA_PRESTAMO
  DEUDA_ABONO
}

enum TransactionStatus {
  REGISTRADA
  PENDIENTE
  CANCELADA
}

enum ScheduledPlanKind {
  SUSCRIPCION
  SERVICIO
  PAGO_PROGRAMADO
}

enum AmountMode {
  FIJO
  VARIABLE
}

enum RecurrenceFrequency {
  DIARIA
  SEMANAL
  MENSUAL
  ANUAL
}

enum OccurrenceStatus {
  PENDIENTE
  EJECUTADA
  OMITIDA
  CANCELADA
}

enum DebtDirection {
  YO_DEBO
  ME_DEBEN
}

enum DebtStatus {
  ACTIVA
  SALDADA
}
